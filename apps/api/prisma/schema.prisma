generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INVITED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SaleItemType {
  SERVICE
  PRODUCT
  PACKAGE
  VOUCHER
  OTHER
}

enum PaymentMethod {
  CASH
  MPESA
  EMOLA
  CARD
  BANK_TRANSFER
  OTHER
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SERVICE_CONSUMPTION
  LOSS
  DAMAGE
  GIFT
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  nuit      String?
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  currency  String   @default("MZN")
  timezone  String   @default("Africa/Maputo")
  language  String   @default("pt")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  settings  Setting[]
  auditLogs AuditLog[]
  clients   Client[]
  employees Employee[]
  serviceCategories ServiceCategory[]
  services  Service[]
  productCategories ProductCategory[]
  products  Product[]
  queueEntries QueueEntry[]
  appointments Appointment[]
  sales     Sale[]
  payments  Payment[]
  cashSessions CashSession[]
  stockMovements StockMovement[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  phone          String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  settings     Setting[]
  auditLogs    AuditLog[]
  clients      Client[]
  employees    Employee[]
  serviceCategories ServiceCategory[]
  services     Service[]
  productCategories ProductCategory[]
  products     Product[]
  queueEntries QueueEntry[]
  appointments Appointment[]
  sales        Sale[]
  payments     Payment[]
  cashSessions CashSession[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@map("branches")
}

model User {
  id               String     @id @default(uuid())
  organizationId   String?
  branchId         String?
  email            String     @unique
  name             String
  phone            String?
  passwordHash     String
  refreshTokenHash String?
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Setting {
  id             String   @id @default(uuid())
  organizationId String?
  branchId       String?
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])

  @@unique([organizationId, branchId, key])
  @@map("settings")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  branchId       String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  device         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, branchId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Client {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  firstName      String
  lastName       String?
  phone          String?
  whatsapp       String?
  email          String?
  birthDate      DateTime?
  gender         String?
  source         String?
  notes          String?
  visits         Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(12, 2)
  loyaltyPoints  Int      @default(0)
  lastVisitAt    DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  queueEntries QueueEntry[]
  appointments Appointment[]
  sales        Sale[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, phone])
  @@map("clients")
}

model Employee {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  name           String
  phone          String?
  email          String?
  role           String
  specialty      String?
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  queueEntries QueueEntry[]
  appointments Appointment[]
  saleItems    SaleItem[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, active])
  @@map("employees")
}

model ServiceCategory {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  services     Service[]

  @@unique([organizationId, name])
  @@map("service_categories")
}

model Service {
  id              String   @id @default(uuid())
  organizationId  String
  branchId        String?
  categoryId      String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(12, 2)
  cost            Decimal  @default(0) @db.Decimal(12, 2)
  tax             Decimal  @default(0) @db.Decimal(5, 2)
  requiresBooking Boolean  @default(false)
  allowWalkIn     Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  branch       Branch?         @relation(fields: [branchId], references: [id])
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  queueEntries QueueEntry[]
  appointments Appointment[]
  saleItems    SaleItem[]

  @@unique([organizationId, name])
  @@index([organizationId, branchId, active])
  @@map("services")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  products     Product[]

  @@unique([organizationId, name])
  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  categoryId     String?
  sku            String
  barcode        String?
  name           String
  brand          String?
  description    String?
  purchasePrice  Decimal  @default(0) @db.Decimal(12, 2)
  salePrice      Decimal  @db.Decimal(12, 2)
  stock          Decimal  @default(0) @db.Decimal(12, 3)
  minimumStock   Decimal  @default(0) @db.Decimal(12, 3)
  unit           String   @default("unidade")
  supplier       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, branchId, active])
  @@map("products")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  productId      String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  beforeQuantity Decimal           @db.Decimal(12, 3)
  afterQuantity  Decimal           @db.Decimal(12, 3)
  reason         String?
  reference      String?
  userId         String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([organizationId, branchId, createdAt])
  @@map("stock_movements")
}

model QueueEntry {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  clientId       String?
  serviceId      String
  employeeId     String?
  customerName   String
  priority       Int         @default(0)
  status         QueueStatus @default(WAITING)
  arrivedAt      DateTime    @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@index([organizationId, branchId, status, arrivedAt])
  @@map("queue_entries")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  clientId       String?
  serviceId      String
  employeeId     String?
  customerName   String
  startsAt       DateTime
  durationMinutes Int
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@index([organizationId, branchId, startsAt])
  @@map("appointments")
}

model Sale {
  id             String     @id @default(uuid())
  organizationId String
  branchId       String
  clientId       String?
  receiptNumber  String     @unique
  status         SaleStatus @default(PAID)
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  tipAmount      Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  paidAmount     Decimal    @db.Decimal(12, 2)
  changeAmount   Decimal    @default(0) @db.Decimal(12, 2)
  note           String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  items        SaleItem[]
  payments     Payment[]

  @@index([organizationId, branchId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String       @id @default(uuid())
  saleId      String
  type        SaleItemType
  serviceId   String?
  productId   String?
  employeeId  String?
  description String
  unitPrice   Decimal      @db.Decimal(12, 2)
  quantity    Decimal      @db.Decimal(12, 3)
  discount    Decimal      @default(0) @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  saleId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId, createdAt])
  @@map("payments")
}

model CashSession {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  openedById     String?
  closedById     String?
  terminal       String            @default("MAIN")
  status         CashSessionStatus @default(OPEN)
  openingBalance Decimal           @default(0) @db.Decimal(12, 2)
  expectedBalance Decimal          @default(0) @db.Decimal(12, 2)
  countedBalance Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@index([organizationId, branchId, status])
  @@map("cash_sessions")
}
