{
  "version": 2,
  "buildCommand": "npm install && npm run db:generate && npm run build",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/apps/web/assets/$1"
    },
    {
      "src": "/(manifest\\.webmanifest|pjlj-logo\\.jpg|pwa-icon\\.svg|sw\\.js)",
      "dest": "/apps/web/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/index.html"
    }
  ]
}
